{
  // Build definition for the prebuilt image ghcr.io/andykenward/devcontainer-dev.
  // Features and customizations here are baked into the image (and its
  // devcontainer.metadata label), so the template that uses it stays thin.
  "name": "dev image",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".",
    "args": {
      // Set by build-image.yaml from the release; "dev" otherwise.
      "IMAGE_VERSION": "${localEnv:IMAGE_VERSION:dev}"
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "remoteUser": "vscode",
  // Run tini as PID 1 so it reaps the zombie processes left by tools that start
  // many children (Claude Code, language servers, test runners) and passes
  // signals on to them.
  "init": true,
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "github.vscode-pull-request-github",
        "github.vscode-github-actions",
        "hverlin.mise-vscode"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh"
      }
    }
  }
}
